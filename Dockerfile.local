# eAdmin Guinée — frontend development image
# Used only by docker-compose.local.yml. Production continues to use Dockerfile.
FROM oven/bun:1.3.4-alpine

WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["bun", "run", "dev"]
